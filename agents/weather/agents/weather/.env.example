# Copy only the settings you need into a private, uncommitted local environment file.
PMD_WEATHER_CURRENT_URL=https://ffd.pmd.gov.pk/weather/current
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_HTTP_TIMEOUT_SECONDS=3.5
WEATHER_RETRIES=1
PMD_MIN_REFRESH_SECONDS=600
OPEN_METEO_MIN_REFRESH_SECONDS=3600
WEATHER_CURRENT_MAX_CACHE_AGE_SECONDS=21600
WEATHER_FORECAST_MAX_CACHE_AGE_SECONDS=86400
WEATHER_CACHE_PATH=~/.cache/kisanos/weather.sqlite3
