# Copy to .env. Never commit keys or farmer data.
APP_NAME=KisanOS API
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./data/kisanos.db
IMAGE_STORAGE_DIR=./data/images
IMAGE_RETENTION_HOURS=24
MAX_UPLOAD_BYTES=10485760
MAX_IMAGES_PER_ASSESSMENT=4
AGENT_TIMEOUT_SECONDS=15
WEATHER_TIMEOUT_SECONDS=8
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
VISION_INFERENCE_URL=
VISION_INFERENCE_TOKEN=
# Optional: local ONNX model directory for the Vision Agent (empty =
# backend/models/wheat_vision/). Point at an empty dir to disable local
# inference (gateway then answers not_assessed).
VISION_MODEL_DIR=
MARKET_ADAPTER_URL=
MARKET_QUOTE_STALE_DAYS=7
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
CONSENT_VERSION=2026-10-03-gemini-v1
POLICY_VERSION=kisanos-safe-policy-1.0.0
SOURCE_REGISTRY_VERSION=2026-10-03.1
LOG_LEVEL=INFO

# Optional consent-gated farmer-language narration of the Farm Plan text only.
# GROQ_API_KEY is not read by the backend at all.
# Photos must NEVER go to Gemini or any third-party inference API: GEMINI_*
# narrate plan text only, and only when the farmer opted in per-assessment.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20
