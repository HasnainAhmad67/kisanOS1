# KisanOS — Vercel environment variables
# Project → Settings → Environment Variables (Production + Preview).
# Copy values; never commit real keys or farmer data.

# --- Database (REQUIRED) ---------------------------------------------------
# Vercel's filesystem is ephemeral and read-only, so the local SQLite default
# only works as a per-instance fallback. Use a real Postgres:
# Vercel Postgres / Neon / Supabase pooled connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/kisanos?sslmode=require

# --- Execution -------------------------------------------------------------
# Run the whole analysis inline inside POST /analyze (background asyncio jobs
# do not survive between serverless invocations). VERCEL=1 is set by the
# platform and also auto-enables this mode; setting it explicitly is clearer.
EXECUTION_MODE=serverless

# --- Storage (only /tmp is writable on Vercel) -----------------------------
IMAGE_STORAGE_DIR=/tmp/kisanos-images
WEATHER_CACHE_PATH=/tmp/weather_cache.sqlite3

# --- CORS ------------------------------------------------------------------
# Same-origin on Vercel (frontend + /api on one *.vercel.app domain), but set
# the deployed origin so browser preflights always pass.
ALLOW_ORIGINS=https://YOUR-PROJECT.vercel.app

# --- Consent / policy (must match the frontend) ----------------------------
CONSENT_VERSION=2026-10-03-gemini-v1

# --- Gemini explanation (Farm Plan TEXT only; photos never leave) ---------
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Vision ----------------------------------------------------------------
# The 21MB ONNX model ships inside the function from
# backend/models/wheat_vision/ (resolved relative to the code, not CWD).
# Only set this if the model lives somewhere else:
VISION_MODEL_DIR=

# --- Misc ------------------------------------------------------------------
DEMO_MODE=true
LOG_LEVEL=INFO
